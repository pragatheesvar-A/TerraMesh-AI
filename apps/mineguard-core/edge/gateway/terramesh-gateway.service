[Unit]
Description=TerraMesh AI Mine Gateway (LoRa mesh -> MQTT uplink)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terramesh
WorkingDirectory=/opt/terramesh/edge/gateway
Environment=GATEWAY_SERIAL_PORT=/dev/ttyUSB0
Environment=MQTT_BROKER_HOST=<cloud-broker-host>
Environment=MQTT_BROKER_PORT=8883
Environment=MQTT_USE_TLS=true
EnvironmentFile=-/etc/terramesh/gateway.env
ExecStart=/opt/terramesh/venv/bin/python /opt/terramesh/edge/gateway/gateway_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
