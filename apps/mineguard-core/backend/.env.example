# TerraMesh AI — Backend Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production & docker stack):
#   postgresql://terramesh:<PASSWORD>@postgres:5432/terramesh
# SQLite (LOCAL DEV ONLY — production refuses it):
#   sqlite:///./mineguard.db
DATABASE_URL=postgresql://terramesh:terramesh_dev_pass@localhost:5432/terramesh

# Connection pooling (PostgreSQL only)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE=1800

# ─── Redis ────────────────────────────────────────────────────────────────────
# Empty string = disabled (in-memory fallback). Note: when Docker publishes
# ports on IPv4 loopback only, prefer 127.0.0.1 over "localhost".
REDIS_URL=redis://127.0.0.1:6379

# ─── API Security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (NEVER use the dev default in production)
SECRET_KEY=change-me-openssl-rand-hex-32
# Session token lifetime for /api/login-issued tokens (seconds, default 12h)
SESSION_TTL_SECONDS=43200

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (wildcard only in non-production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MINE_ID=jharia_01
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# CA bundle for TLS verification (required in production with TLS)
MQTT_CA_CERT=

# ─── SMS Gateway (env-driven ONLY — no credentials in source) ────────────────
# SMSGate-compatible gateway:
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
# Fast2SMS cloud gateway:
FAST2SMS_API_KEY=
# Without any gateway, dispatches are labelled "SIMULATED DISPATCH" and never sent.

# ─── Firebase / FCM ───────────────────────────────────────────────────────────
# Path to Firebase service account JSON (empty = FCM disabled, honestly reported)
FIREBASE_CREDENTIALS_PATH=

# ─── InSAR Provider ────────────────────────────────────────────────────────────
# mock (default, labelled SIMULATED SATELLITE DATA) | sentinel | nisar
# sentinel/nisar raise BLOCKED until credentials exist — they never fabricate.
INSAR_PROVIDER=mock
# Copernicus Data Space credentials (for INSAR_PROVIDER=sentinel)
COP_USER=
COP_PASSWORD=

# ─── Risk Engine (project engineering limits — NOT statutory thresholds) ─────
# Optional JSON override, e.g.:
# RISK_THRESHOLDS_OVERRIDE={"tilt":{"warning_high":1.5,"critical_high":3.0}}
RISK_THRESHOLDS_OVERRIDE=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Environment ─────────────────────────────────────────────────────────────
# development | production   (production: disables demo login, legacy tokens,
# and wildcard CORS; requires PostgreSQL)
ENVIRONMENT=development

# InSAR Configuration
INSAR_PROVIDER=mock
INSAR_USERNAME=
INSAR_PASSWORD=
INSAR_CLIENT_ID=
INSAR_CLIENT_SECRET=
INSAR_DATA_ENDPOINT=
